# Copie para .env antes de rodar (docker compose --env-file / env_file ja aponta pra .env).

# Token exigido no header X-Checker-Token em POST /check.
# Deixe em branco para testes manuais locais — sem token, o endpoint fica aberto.
CHECKER_API_TOKEN=

# debug | info | warn | error (padrao: warn)
LOG_LEVEL=
