# Copie para .env antes de rodar.

# Porta da ponte (o Rails fala com ela por aqui).
PORT=3400

# Segredo exigido no header X-Bridge-Token. Precisa ser IGUAL ao bridge_token
# do provider_config da caixa no Chatwoot.
BRIDGE_TOKEN=

# Onde a ponte entrega a mensagem recebida. Em docker compose local, o host do
# Rails e "rails"; fora do compose, use a URL que o seu Chatwoot responde.
# A caixa de destino vem da sessao (uma sessao = um numero), nao daqui.
CHATWOOT_URL=http://rails:3000

# Segredo que a ponte apresenta ao Chatwoot ao entregar mensagem. Precisa ser
# IGUAL ao webhook_verify_token do provider_config da caixa.
CHATWOOT_WEBHOOK_TOKEN=

# debug | info | warn | error (padrao: warn)
LOG_LEVEL=warn
