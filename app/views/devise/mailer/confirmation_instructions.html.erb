<%
  brand_name = global_config['BRAND_NAME'] || 'Chatmobílli'
  recipient_name = @resource.name.presence || @resource.email
  account_user = @resource&.account_users&.first
  inviter = account_user&.inviter
  account_name = account_user&.account&.name
  invited_user = inviter.present? && @resource.unconfirmed_email.blank?

  eyebrow = 'Boas-vindas'
  heading = 'Confirme seu e-mail para começar'
  intro_text =
    "Boas-vindas ao #{brand_name}. Só precisamos verificar seu endereço de e-mail antes de você começar a usar sua conta."
  supporting_text = 'Isso leva apenas um momento.'
  action_text = 'Confirmar minha conta'
  action_url = frontend_url('auth/confirmation', confirmation_token: @token)
  info_title = nil
  info_text = nil
  detail_rows = []
  detail_rows << ['Novo e-mail', @resource.unconfirmed_email] if @resource.unconfirmed_email.present?

  if @resource.unconfirmed_email.present?
    eyebrow = 'Atualização de e-mail'
    heading = 'Confirme seu novo e-mail'
    intro_text = "Recebemos uma solicitação para atualizar o endereço de e-mail da sua conta no #{brand_name}."
    supporting_text = 'Confirme o novo endereço abaixo para concluir a alteração.'
    action_text = 'Confirmar endereço de e-mail'
  elsif @resource.confirmed?
    eyebrow = 'Conta pronta'
    heading = 'Sua conta está pronta'
    intro_text = "Sua conta do #{brand_name} já está ativa."
    supporting_text = 'Clique no botão abaixo para fazer login e continuar de onde parou.'
    action_text = 'Acessar minha conta'
    action_url = frontend_url('auth/sign_in')
    detail_rows = []
  elsif invited_user
    eyebrow = 'Convite para o Workspace'
    heading = account_name.present? ? "Você recebeu um convite para participar da #{account_name}" : "Você recebeu um convite para experimentar o #{brand_name}"
    intro_text = if account_name.present?
      "#{inviter.name} convidou você para fazer parte do workspace #{account_name} no #{brand_name}."
    else
      "#{inviter.name} convidou você para experimentar o #{brand_name}."
    end
    supporting_text = 'Crie a sua conta para começar a colaborar com sua equipe.'
    action_text = 'Aceitar convite'
    action_url = frontend_url(
      'auth/password/edit',
      reset_password_token: @resource.send(:set_reset_password_token)
    )
    detail_rows = [['Convidado por', inviter.name]]
    detail_rows << ['Workspace', account_name] if account_name.present?
  end
%>

<%= render partial: 'devise/mailer/confirmation_body', locals: {
  action_text: action_text,
  action_url: action_url,
  detail_rows: detail_rows,
  eyebrow: eyebrow,
  heading: heading,
  info_text: info_text,
  info_title: info_title,
  intro_text: intro_text,
  recipient_name: recipient_name,
  supporting_text: supporting_text
} %>
